# NEX ML Runner - Custom RunPod Image
# 
# Build: docker build -f docker/Dockerfile.runpod -t your-username/nex-ml:v1 .
# Push:  docker push your-username/nex-ml:v1
#
# Use this image for:
# - RunPod serverless endpoints
# - RunPod pod templates
# - Any GPU compute with consistent environment

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

LABEL maintainer="NEX ML Team"
LABEL description="NEX ML Runner with LightGBM and forecasting dependencies"

# Set environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1

# Install ML dependencies
COPY backend/ml_models/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip && \
    pip install -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# Create working directories
RUN mkdir -p /app/ml_models /app/data /app/models /app/outputs

# Copy ML code
COPY backend/ml_models/ /app/ml_models/

WORKDIR /app

# Verify installation
RUN python -c "import lightgbm, sklearn, pandas, numpy, pyarrow, boto3; print('✅ All packages installed')"

# Default command (can be overridden)
CMD ["python", "-c", "print('NEX ML Runner ready. Pass a command to run.')"]
