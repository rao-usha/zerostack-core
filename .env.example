# ZeroStack Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ENCRYPTION (REQUIRED)
# =============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# =============================================================================
# LLM API KEYS (at least one required for chat features)
# =============================================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
X_AI_API_KEY=xai-...

# =============================================================================
# DATABASE - Primary (auto-created by docker-compose)
# =============================================================================
DATABASE_URL=postgresql+psycopg://nex:nex@localhost:5432/nex

# =============================================================================
# DATABASE - Data Explorer connections
# =============================================================================
EXPLORER_DB_HOST=localhost
EXPLORER_DB_PORT=5432
EXPLORER_DB_USER=nex
EXPLORER_DB_PASSWORD=nex
EXPLORER_DB_NAME=nex

# Second database (optional)
EXPLORER2_DB_HOST=
EXPLORER2_DB_PORT=
EXPLORER2_DB_USER=
EXPLORER2_DB_PASSWORD=
EXPLORER2_DB_NAME=

# =============================================================================
# OBJECT STORAGE (MinIO/S3)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nex-data
S3_USE_SSL=false

# =============================================================================
# GPU COMPUTE (optional)
# =============================================================================
# Options: local, ssh, runpod
COMPUTE_ADAPTER=local

# RunPod settings (if COMPUTE_ADAPTER=runpod)
RUNPOD_API_KEY=
RUNPOD_DEFAULT_GPU=NVIDIA RTX A5000
RUNPOD_ENDPOINT_ID=
RUNPOD_POD_ID=

# SSH settings (if COMPUTE_ADAPTER=ssh)
SSH_HOST=
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_DOCKER_RUNTIME=nvidia

# =============================================================================
# NOTIFICATIONS (optional - for drift alerts and schedule notifications)
# =============================================================================
# Email (SMTP)
NOTIFICATION_SMTP_HOST=smtp.gmail.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAILS=admin@example.com,ops@example.com

# Slack (Incoming Webhook)
NOTIFICATION_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
NOTIFICATION_SLACK_CHANNEL=#alerts

# Generic Webhook
NOTIFICATION_WEBHOOK_URL=https://your-webhook-endpoint.com/notify
NOTIFICATION_WEBHOOK_HEADERS={"Authorization": "Bearer your-token"}

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
